# --- Ollama 공통 ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat

# --- 하이브리드 경로 ---
# 이미지 영역 OCR 전용 모델. 폴백이 없으므로 이 모델을 반드시 pull 해두세요.
#   ollama pull qwen2.5vl:7b
IMAGE_OCR_MODEL=qwen2.5vl:7b
IMAGE_OCR_TIMEOUT=6000
# 풀페이지 스캔처럼 큰 이미지에서 컨텍스트 초과로 400이 나는 것을 막기 위한 값입니다.
IMAGE_OCR_NUM_CTX=4096
# OCR에 보내는 이미지의 긴 변 최대 픽셀 수. 이보다 크면 비율을 유지해 줄입니다.
MAX_OCR_IMAGE_PX=1200

# 추출된 텍스트로 키워드·요약을 만드는 모델 (이미지를 받지 않습니다)
OLLAMA_SUMMARY_MODEL=qwen2.5vl:7b
OLLAMA_SUMMARY_NUM_CTX=8192
OLLAMA_SUMMARY_TIMEOUT=6000

# 레이아웃 판단. PaddleOCR 미설치 시 자동으로 PyMuPDF 기하 판단으로 내려갑니다.
PADDLE_LAYOUT_MODEL=PP-DocLayoutV2
LAYOUT_DPI=150
OCR_DPI=200

# --- 비교용 vlm 경로 (method=vlm) ---
# 전 페이지를 이미지로 넘기는 기존 방식입니다. 이미지 입력 지원 모델이어야 합니다.
OLLAMA_ANALYSIS_MODEL=qwen2.5vl:7b
# 페이지 수가 많을수록 오래 걸리므로 문서 길이에 맞춰 늘려주세요.
OLLAMA_ANALYSIS_TIMEOUT=6000
